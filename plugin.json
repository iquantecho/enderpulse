{
  "$schema": "https://raw.githubusercontent.com/duxlabs-dev/dux-shell/master/quickshell/PLUGINS/plugin-schema.json",
  "id": "enderPulse",
  "name": "EnderPulse",
  "description": "A responsive Cava visualizer for the Dux bar, dock, and desktop",
  "version": "1.2.0",
  "author": "iquantecho",
  "type": "composite",
  "capabilities": [
    "daemon",
    "dankbar-widget",
    "desktop-widget",
    "variants"
  ],
  "components": {
    "daemon": "./EnderPulseService.qml",
    "widget": "./EnderPulseBar.qml",
    "desktop": "./EnderPulse.qml"
  },
  "settings": "./EnderPulseSettings.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "graphic_eq",
  "requires_dms": ">=2.0.0",
  "dependencies": [
    "cava"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "process"
  ]
}
